{
  "name": "@helixar/mcp",
  "version": "0.8.0",
  "description": "Helixar Security MCP server: scan MCP servers for security risks, validate and verify HDP delegation chains, audit releases.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/server.js",
  "bin": {
    "helixar-mcp": "dist/server.js"
  },
  "imports": {
    "#url-guard": {
      "workerd": "./dist/lib/url-guard.workers.js",
      "default": "./dist/lib/url-guard.js"
    },
    "#releaseguard": {
      "workerd": "./dist/lib/releaseguard-entry.workers.js",
      "default": "./dist/lib/releaseguard-entry.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:worker-bundle": "node scripts/check-worker-bundle.mjs",
    "test:worker": "npm run build && node scripts/worker-smoke.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:tail": "wrangler tail"
  },
  "keywords": [
    "mcp",
    "claude",
    "anthropic",
    "security",
    "agentic-ai",
    "helixar"
  ],
  "author": "Helixar Limited",
  "license": "Apache-2.0",
  "homepage": "https://helixar.ai/connect",
  "repository": {
    "type": "git",
    "url": "https://github.com/Helixar-AI/helixar-mcp"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.30.1",
    "@helixar_ai/hdp": "0.2.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "undici": "^6.29.1",
    "zod": "3.23.8",
    "zod-to-json-schema": "3.23.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "20.17.10",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.39.4",
    "tsx": "4.21.0",
    "typescript": "5.7.2",
    "vitest": "4.1.5",
    "wrangler": "^4.165.0"
  }
}
