{
  "name": "@helixar/mcp",
  "version": "0.0.1",
  "description": "Helixar Claude Connector — three agentic-AI security tools (Sentinel MCP scanner, HDP delegation validator, Vigil/ATP kill-chain triage) exposed as a remote MCP server.",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "main": "dist/server.js",
  "bin": {
    "helixar-mcp": "dist/server.js"
  },
  "imports": {
    "#url-guard": {
      "workerd": "./dist/lib/url-guard.workers.js",
      "default": "./dist/lib/url-guard.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:tail": "wrangler tail"
  },
  "keywords": [
    "mcp",
    "claude",
    "anthropic",
    "security",
    "agentic-ai",
    "helixar"
  ],
  "author": "Helixar Limited",
  "license": "Apache-2.0",
  "homepage": "https://helixar.ai/connect",
  "repository": {
    "type": "git",
    "url": "https://github.com/Helixar-AI/helixar-mcp"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.30.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "undici": "^6.27.0",
    "zod": "3.23.8",
    "zod-to-json-schema": "3.23.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@types/node": "20.17.10",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.39.4",
    "tsx": "4.21.0",
    "typescript": "5.7.2",
    "vitest": "4.1.5",
    "wrangler": "^4.104.0"
  }
}
